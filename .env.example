# Public demo configuration only. Copy to .env; never commit real settings.
VEHICLE_MOCK=1
VEHICLE_CATALOG_URL=http://127.0.0.1:4010
VEHICLE_INSURED_URL=http://127.0.0.1:4011
VEHICLE_TIMEOUT_MS=10000
# Production: set VEHICLE_MOCK=0 and HTTPS API URLs, then configure OAuth.
# CLERK_OAUTH_ISSUER=https://your-issuer.example
# CLERK_OAUTH_CLIENT_ID=your-public-client-id
CLERK_OAUTH_SCOPES="openid profile"
CLERK_OAUTH_CALLBACK_PORT=8765
# CLERK_OAUTH_AUDIENCE=your-api-audience
VEHICLE_CREDENTIAL_STORE=keyring
# Optional POSIX fallback; choose an owner-only directory:
# VEHICLE_CREDENTIAL_STORE=file
# VEHICLE_CREDENTIAL_FILE=/absolute/private/my-harness/credentials.json
